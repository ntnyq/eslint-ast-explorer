{
  "name": "eslint-ast-explorer",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.21.0",
  "description": "ESLint AST Explorer.",
  "keywords": [],
  "repository": "ntnyq/eslint-ast-explorer",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "generate": "nuxt generate",
    "lint": "eslint",
    "postinstall": "nuxt prepare",
    "prepare": "husky",
    "preview": "nuxt preview",
    "release": "run-s release:check release:version",
    "release:check": "run-s format:check lint typecheck",
    "release:version": "bumpp",
    "typecheck": "nuxt typecheck"
  },
  "dependencies": {
    "@babel/eslint-parser": "^8.0.1",
    "@babel/parser": "^8.0.4",
    "@lucide/vue": "^1.31.0",
    "@ntnyq/utils": "^0.21.1",
    "@shikijs/core": "^4.4.3",
    "@shikijs/engine-javascript": "^4.4.3",
    "@shikijs/langs": "^4.4.3",
    "@shikijs/monaco": "^4.4.3",
    "@shikijs/themes": "^4.4.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/esprima": "^4.0.6",
    "@typescript-eslint/parser": "^8.67.0",
    "@vueuse/core": "^14.4.0",
    "astro-eslint-parser": "^3.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.21",
    "eslint-mdx": "^3.8.1",
    "espree": "^11.2.0",
    "esprima": "^4.0.1",
    "json-to-ast": "^2.1.0",
    "json5": "^2.2.3",
    "jsonc-eslint-parser": "^3.3.0",
    "monaco-editor": "^0.56.0",
    "reka-ui": "^2.10.3",
    "svelte": "^5.56.8",
    "svelte-eslint-parser": "^1.8.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "toml-eslint-parser": "^1.0.3",
    "tw-animate-css": "^1.4.0",
    "vue-eslint-parser": "^10.4.1",
    "yaml-eslint-parser": "^2.1.0"
  },
  "devDependencies": {
    "@ntnyq/eslint-config": "^6.1.5",
    "@rolldown/plugin-node-polyfills": "^1.0.3",
    "@types/node": "^26.2.0",
    "@vueuse/nuxt": "^14.4.0",
    "bumpp": "^12.2.0",
    "consola": "^3.4.2",
    "eslint": "^10.8.1",
    "husky": "^9.1.7",
    "nano-staged": "^1.0.2",
    "npm-run-all2": "^9.0.3",
    "nuxt": "^4.5.2",
    "nuxt-monaco-editor": "^1.4.1",
    "nuxt-umami": "^3.2.1",
    "oxfmt": "^0.63.0",
    "pathe": "^2.0.3",
    "rolldown": "^1.2.3",
    "shadcn-nuxt": "^2.8.2",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "unenv": "^1.10.0",
    "unplugin-replace": "^0.9.0",
    "vite": "^8.2.1",
    "vue-tsc": "^3.3.9"
  },
  "nano-staged": {
    "*.{js,ts,mjs,tsx,vue,md,yml,yaml,toml,json}": "eslint --fix --no-error-on-unmatched-pattern",
    "*": "oxfmt --no-error-on-unmatched-pattern"
  }
}
