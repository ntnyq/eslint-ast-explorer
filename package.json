{
  "name": "eslint-ast-explorer",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@12.14.0",
  "description": "ESLint AST Explorer.",
  "keywords": [],
  "repository": "ntnyq/eslint-ast-explorer",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "generate": "nuxt generate",
    "lint": "eslint",
    "postinstall": "nuxt prepare",
    "prepare": "husky",
    "preview": "nuxt preview",
    "release": "run-s release:check release:version",
    "release:check": "run-s format:check lint typecheck",
    "release:version": "bumpp",
    "test:e2e": "playwright test",
    "typecheck": "run-s typecheck:vue typecheck:native",
    "typecheck:native": "node node_modules/@typescript/native/bin/tsc --noEmit -p .nuxt/tsconfig.node.json",
    "typecheck:vue": "nuxt typecheck"
  },
  "dependencies": {
    "@astrojs/compiler-binding-wasm32-wasi": "0.5.2",
    "@babel/eslint-parser": "^8.0.7",
    "@babel/parser": "^8.0.7",
    "@lucide/vue": "^1.59.0",
    "@ntnyq/utils": "^0.23.0",
    "@shikijs/core": "^4.5.0",
    "@shikijs/engine-javascript": "^4.5.0",
    "@shikijs/langs": "^4.5.0",
    "@shikijs/monaco": "^4.5.0",
    "@shikijs/themes": "^4.5.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/esprima": "^4.0.6",
    "@typescript-eslint/parser": "^8.71.2",
    "@vueuse/core": "^15.0.0",
    "astro-eslint-parser": "^3.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.23",
    "eslint-mdx": "^3.8.1",
    "espree": "^11.2.0",
    "esprima": "^4.0.1",
    "json-to-ast": "^2.1.0",
    "json5": "^2.2.3",
    "jsonc-eslint-parser": "^3.3.0",
    "monaco-editor": "^0.57.0",
    "reka-ui": "^2.11.0",
    "semver": "7.8.5",
    "svelte": "^5.57.2",
    "svelte-eslint-parser": "^1.9.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "toml-eslint-parser": "^1.0.3",
    "tw-animate-css": "^1.4.0",
    "vue-eslint-parser": "^10.4.1",
    "yaml-eslint-parser": "^2.1.0"
  },
  "devDependencies": {
    "@ntnyq/eslint-config": "^6.1.5",
    "@playwright/test": "1.64.1",
    "@rolldown/plugin-node-polyfills": "^1.0.4",
    "@types/node": "^26.6.5",
    "@types/semver": "^7.8.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vueuse/nuxt": "^15.0.0",
    "bumpp": "^12.3.0",
    "consola": "^3.4.2",
    "eslint": "^10.13.0",
    "husky": "^9.1.7",
    "nano-staged": "^1.0.2",
    "npm-run-all2": "^9.0.3",
    "nuxt": "^4.6.2",
    "nuxt-monaco-editor": "^1.5.0",
    "nuxt-umami": "^3.2.1",
    "oxfmt": "^0.73.0",
    "pathe": "^2.0.3",
    "rolldown": "^1.2.14",
    "shadcn-nuxt": "^2.8.2",
    "tsx": "^4.23.15",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "unenv": "^1.10.0",
    "unplugin-replace": "^0.9.1",
    "vite": "^8.3.4",
    "vue-tsc": "^3.3.13"
  },
  "nano-staged": {
    "*.{js,ts,mjs,tsx,vue,md,yml,yaml,toml,json}": "eslint --fix --no-error-on-unmatched-pattern",
    "*": "oxfmt --no-error-on-unmatched-pattern"
  }
}
